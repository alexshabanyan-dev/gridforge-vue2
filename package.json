{
  "name": "gridforge-vue2",
  "version": "0.1.0",
  "description": "A flexible Vue 2 table component library with column reordering, resizing, and visibility controls",
  "type": "module",
  "main": "dist/gridforge-vue2.umd.js",
  "module": "dist/gridforge-vue2.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gridforge-vue2.es.js",
      "require": "./dist/gridforge-vue2.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly --project tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "type-check": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue",
    "vue2",
    "table",
    "grid",
    "data-table",
    "column-resize",
    "column-reorder",
    "column-visibility",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^2.7.8",
    "floating-vue": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    },
    "floating-vue": {
      "optional": false
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.0.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "~5.1.0",
    "vite": "^5.4.10",
    "vue": "^2.7.8",
    "vue-template-compiler": "^2.7.8",
    "vue-tsc": "^2.0.29"
  },
  "dependencies": {
    "@tanstack/table-core": "^8.20.0",
    "floating-vue": "vue2"
  }
}
